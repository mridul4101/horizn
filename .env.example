# ── Ingestion Sources (Choose One) ────────────────────────────
# Option A (Default): Full Apple Photos library with date range
PHOTOS_LIBRARY_PATH=~/Pictures/Photos Library.photoslibrary
INGEST_BATCH_MONTHS=12

# Option B (Recommended for curated control): An Album in Apple Photos
# Create an album in Photos app named "Horizn" and add photos to it
# PHOTOS_ALBUM_NAME=Horizn

# Option C: Raw local folder on your Mac (completely bypass Apple Photos)
# LOCAL_PHOTOS_DIR=/Users/username/Pictures/MyVacation

# ── Privacy Filter ───────────────────────────────────────────
FACE_CONFIDENCE_THRESHOLD=0.7
MIN_FACE_AREA_RATIO=0.03

# ── Export & Converted JPEGs ─────────────────────────────────
EXPORT_DIR=./data/exports
JPEG_QUALITY=92

# ── Gemini API (Free Tier) ───────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-3.1-flash-lite
GEMINI_PRO_MODEL=gemini-3.1-flash-lite

# ── Instagram / Meta Graph API ───────────────────────────────
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
IG_USER_ID=your_ig_user_id
IG_ACCESS_TOKEN=your_long_lived_token

# ── Local Server Ports ───────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=5173

# ── Carousel Clustering ──────────────────────────────────────
CLUSTER_TIME_WINDOW_HOURS=48
CLUSTER_GPS_RADIUS_KM=5.0
CAROUSEL_MIN_SLIDES=1
CAROUSEL_MAX_SLIDES=10
